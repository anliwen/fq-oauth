<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.hczq</groupId>
        <artifactId>fq-oauth</artifactId>
        <version>1.0.0-RELEASE</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>fq-server</artifactId>
    <name>fq-server</name>
    <description>Application entry that assembles all business modules</description>
    <dependencies>
        <dependency><groupId>com.mysql</groupId><artifactId>mysql-connector-j</artifactId><scope>runtime</scope></dependency>
        <dependency><groupId>com.hczq</groupId><artifactId>fq-module-platform</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.hczq</groupId><artifactId>fq-module-user</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.hczq</groupId><artifactId>fq-module-org</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.hczq</groupId><artifactId>fq-module-tenant</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.hczq</groupId><artifactId>fq-module-authn</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.hczq</groupId><artifactId>fq-module-oauth2</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.hczq</groupId><artifactId>fq-module-oauth-provider</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.hczq</groupId><artifactId>fq-module-federation</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.hczq</groupId><artifactId>fq-module-authz</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.hczq</groupId><artifactId>fq-module-audit</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.hczq</groupId><artifactId>fq-module-agent</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.hczq</groupId><artifactId>fq-module-delegation</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.hczq</groupId><artifactId>fq-module-mcp</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.hczq</groupId><artifactId>fq-module-consent</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.hczq</groupId><artifactId>fq-module-quota</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.hczq</groupId><artifactId>fq-module-policy</artifactId><version>${project.version}</version></dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
